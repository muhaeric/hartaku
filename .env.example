# Copy to .env and fill in. NEVER commit the real .env - this repo is public.

# Google Cloud > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random 32+ char string used to encrypt the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PIN used only for the admin dashboard. Use a long, unique numeric value.
ADMIN_PIN=

# Optional comma-separated recipients for new-user notification emails.
ADMIN_EMAILS=

# Welcome email + new-user notification, sent through Resend. The Vercel
# integration provisions the API key and domain. EMAIL_FROM is an optional
# override; by default the app sends as Hartaku <halo@RESEND_EMAIL_DOMAIN>.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
EMAIL_FROM=

# PostgreSQL connection string for the user registry. A Neon database connected
# through the Vercel Marketplace provides this automatically.
DATABASE_URL=

# Optional. Only needed if the app is served behind a proxy that rewrites the Host
# header. When empty the redirect URI is derived from the incoming request origin.
APP_URL=
